# ==============================================================================
# Banking Retention Intelligence Platform - Environment Configuration Example
# Copy this file to .env and adjust variables as appropriate.
# NEVER commit .env with real credentials or production secrets to source control.
# ==============================================================================

# API Security (Optional API key; if set, clients must supply X-API-Key header)
API_KEY=your-secure-api-key-here

# API Batch Ingestion Limits
MAX_BATCH_ROWS=5000
MAX_BATCH_BYTES=5242880

# CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Persistent Storage Database URL
# Default SQLite storage (uses named Docker volume / persistent file):
DATABASE_URL=sqlite:////app/data/campaigns/retention_campaigns.db
# PostgreSQL storage (when running docker compose --profile postgres up):
# DATABASE_URL=postgresql+psycopg2://retention_user:retention_pass@postgres:5432/retention_db

# Decision Engine & Risk Tier Thresholds
DECISION_THRESHOLD=0.35
RISK_THRESHOLD_LOW=0.20
RISK_THRESHOLD_HIGH=0.50

# Customer Lifetime Value (CLV) Financial Proxy Assumptions
CLV_NET_INTEREST_MARGIN=0.03
CLV_ANNUAL_FEE_INCOME=50.0
CLV_ANNUAL_SERVICING_COST=40.0
CLV_TIME_HORIZON_YEARS=3
CLV_DISCOUNT_RATE=0.08

# Streamlit Platform UI Server Config
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
